{
  "manifest_version": 3,
  "name": "Carleton Lecture Downloader",
  "version": "2.0.0",
  "description": "Downloads Lectures on Brightspace and Mediaspace",

  "permissions": ["clipboardRead", "storage", "downloads"],

  "host_permissions": ["https://cdnapisec.kaltura.com/*"],

  "action": {
    "default_popup": "index.html",
    "default_icon": {
      "128": "icons/128.png"
    }
  },

  "icons": {
    "128": "icons/128.png"
  }
}
